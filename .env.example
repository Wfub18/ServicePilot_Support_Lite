# Create a copy named .env and paste your OpenAI API key here.
OPENAI_API_KEY=your_openai_api_key_here

# You can replace the model without editing the application code.
OPENAI_MODEL=gpt-5.4-mini

# Optional server settings.
PORT=3000
OPENAI_TIMEOUT_MS=90000
# Per-attempt wait for HTTP headers, capped at 30000 ms.
OPENAI_ATTEMPT_TIMEOUT_MS=30000
# Emergency switch: false disables chat before any provider request.
CHAT_ENABLED=true
